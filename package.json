{
  "name": "mot-ngay-moi",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "Một Ngày Mới / New Day — fictional 3D prison life simulator (web, single-player)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs http://localhost:5173/ .",
    "smoke:panels": "node scripts/panels.mjs .",
    "test:resume": "node scripts/resume.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^7.54.0",
    "@supabase/supabase-js": "^2.49.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "^1.64.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
